# Dashboard: usuarios en SQLite, creados con scripts/create_user.py.
# Producción requiere HTTPS (directo o proxy de confianza).
DASHBOARD_ENV=production
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_SESSION_HOURS=8
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_LOCK_SECONDS=300

# DVR
DVR_HOST=192.168.0.100
DVR_RTSP_PORT=554
DVR_USERNAME=detector
DVR_PASSWORD=CAMBIAR_LOCALMENTE

# Cámara A1
CAMERA_A1_ENABLED=true
CAMERA_A1_ID=A1
CAMERA_A1_NAME=Camara_A1
CAMERA_A1_CHANNEL=101
CAMERA_A1_TARGET_FPS=5
CAMERA_A1_LINE_ENABLED=true
CAMERA_A1_LINE_START_X=0.20
CAMERA_A1_LINE_START_Y=0.55
CAMERA_A1_LINE_END_X=0.80
CAMERA_A1_LINE_END_Y=0.55
CAMERA_A1_LINE_INVERT_DIRECTION=false
CAMERA_A1_EVENT_DIRECTIONS=both
CAMERA_A1_PASSAGE_ENABLED=true
CAMERA_A1_PASSAGE_EVENT=ENTRADA
CAMERA_A1_PASSAGE_DIRECTION=forward
CAMERA_A1_TRIGGER_PROGRESS=0.15
CAMERA_A1_CORRIDOR_ENABLED=true
CAMERA_A1_CORRIDOR_POINTS=0.27,0.98;0.43,0.83;0.59,0.69;0.70,0.58
CAMERA_A1_CORRIDOR_HALF_WIDTH=0.08
CAMERA_A1_CORRIDOR_INVERT_DIRECTION=false
CAMERA_A1_GATE_START_X=0.28
CAMERA_A1_GATE_START_Y=0.92
CAMERA_A1_GATE_END_X=0.52
CAMERA_A1_GATE_END_Y=0.72
CAMERA_A1_GATE_INVERT_DIRECTION=false
CAMERA_A1_ROOM_1_POLYGON=
CAMERA_A1_ROOM_2_POLYGON=
CAMERA_A1_ROOM_3_POLYGON=

