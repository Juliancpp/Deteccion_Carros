[Unit]
Description=Dashboard Web & API REST - Hotel MVP
After=network.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_WORKING_DIR
Environment=PYTHONUNBUFFERED=1
ExecStart=REPLACE_WORKING_DIR/venv/bin/uvicorn app.api:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
