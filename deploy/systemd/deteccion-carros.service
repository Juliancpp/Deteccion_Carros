[Unit]
Description=Detector Multicámara de Vehículos - Hotel MVP
After=network.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_WORKING_DIR
Environment=PYTHONUNBUFFERED=1
ExecStart=REPLACE_WORKING_DIR/venv/bin/python scripts/run_hotel_mvp.py --continuous --status-file data/runtime/hotel_status.json --latest-snapshots --enable-clips
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
